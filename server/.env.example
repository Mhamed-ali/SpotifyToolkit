PORT=8888
HOST=0.0.0.0
LOG_LEVEL=info
USE_HTTPS=true
SSL_COMMON_NAME=localhost
FRONTEND_URI=https://localhost:5173

# Spotify API Credentials
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
REDIRECT_URI=https://localhost:8888/callback

# Anghami SDK Credentials (Optional - sdk.anghami.com)
ANGHAMI_CLIENT_ID=your_anghami_client_id_here
ANGHAMI_CLIENT_SECRET=your_anghami_client_secret_here
ANGHAMI_API_KEY=your_anghami_api_key_here
ANGHAMI_REDIRECT_URI=https://localhost:8888/anghami/callback
